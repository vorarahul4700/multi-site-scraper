# ============================================================================
# Multi-Site Scraper & Operations Dashboard Configuration
# ============================================================================

# ----------------------------------------------------------------------------
# 1. GitHub Actions Orchestrator (Dashboard Connection)
# ----------------------------------------------------------------------------
GITHUB_TOKEN=github_pat_your_token_here
GITHUB_REPO=vorarahul4700/multi-site-scraper
GITHUB_BRANCH=main
PORT=5050

# ----------------------------------------------------------------------------
# 2. PostgreSQL Database (Railway / Production - Handles Millions of Records)
# ----------------------------------------------------------------------------
# Railway automatically injects DATABASE_URL when you attach a Postgres service:
DATABASE_URL=postgresql://postgres:password@roundhouse.proxy.rlwy.net:12345/railway

# Or configure individual PostgreSQL parameters:
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=secretpassword
PGDATABASE=railway

# ----------------------------------------------------------------------------
# 3. Remote Storage / FTP (Optional Secondary Backup)
# ----------------------------------------------------------------------------
FTP_HOST=
FTP_PORT=21
FTP_USER=
FTP_PASS=
FTP_PATH=/uploads/

# ----------------------------------------------------------------------------
# 4. Anti-Bot & Captcha Solving APIs (Optional)
# ----------------------------------------------------------------------------
FLARESOLVERR_URL=http://localhost:8191/v1
NVIDIA_API_KEY=

# ----------------------------------------------------------------------------
# 5. MySQL Database (Legacy Support)
# ----------------------------------------------------------------------------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASS=
MYSQL_DB=
